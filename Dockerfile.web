FROM node:20-alpine AS builder

WORKDIR /app

ARG VITE_API_URL
ARG VITE_SOCKET_URL
ARG WEB_PORT=2027

COPY package*.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN npm ci

COPY . .

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL

RUN npm run build --workspace @guess-the-word/web

FROM nginx:alpine

ARG WEB_PORT=2027
ENV WEB_PORT=$WEB_PORT

COPY docker/nginx.web.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 2027

CMD ["sh", "-c", "envsubst '$$WEB_PORT' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]
